{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/shot_manifest",
  "title": "Shot Manifest",
  "description": "The bulk video-generation job spec. Each shot is fully resolved (prompt, keyframe, provider, duration, seed) so generation can run as one batch on a rented GPU box. Hero shots are generated in the local prep phase (status=done) for review before the batch.",
  "type": "object",
  "required": ["version", "project", "shots", "segments"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "target_duration_s", "shot_ids"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^seg_[0-9]{3}$" },
          "target_duration_s": { "type": "number", "minimum": 0 },
          "shot_ids": { "type": "array", "items": { "type": "string" } },
          "output": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "shot_id", "provider", "operation", "video_prompt", "duration_s", "seed", "output"],
        "properties": {
          "segment_id": { "type": "string", "pattern": "^seg_[0-9]{3}$" },
          "shot_id": { "type": "string", "pattern": "^shot_[0-9]{2}$" },
          "provider": { "type": "string", "description": "wan (box default) or kie (hero, prep)" },
          "operation": { "type": "string", "enum": ["image_to_video", "text_to_video"] },
          "video_prompt": { "type": "string" },
          "duration_s": { "type": "number", "minimum": 0 },
          "seed": { "type": "integer" },
          "output": { "type": "string" },
          "keyframe": { "type": "string", "description": "i2v anchor image path; empty for text_to_video" },
          "aspect_ratio": { "type": "string", "default": "16:9" },
          "hero": { "type": "boolean", "default": false },
          "status": { "type": "string", "enum": ["pending", "done", "failed"], "default": "pending" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
