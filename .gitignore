# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Test/IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.trae/
.idea/
.vscode/

# Pipeline outputs (regenerable — never commit large media)
output/
pipeline/
tests/qa/output/

# Project workspaces (generated assets, renders — all regenerable)
# EXCEPT the v6 production drivers + the hand-tuned scored script: they ARE
# the production system (docs/PRODUCTION_WORKFLOW.md §3) and are not
# regenerable — losing this disk must not lose the pipeline.
projects/*
!projects/therac-25-test/
projects/therac-25-test/*
!projects/therac-25-test/script_v5/
projects/therac-25-test/script_v5/*
!projects/therac-25-test/script_v5/*.py
!projects/therac-25-test/script_v5/scored_script.yaml
# Approval state + small identity artifacts: the source of truth for every
# gate/verdict/promotion (append-only text) — losing the disk must not lose
# the production's decision history. Media stays out of git.
!projects/therac-25-test/feedback/
projects/therac-25-test/feedback/*
!projects/therac-25-test/feedback/events.jsonl
!projects/therac-25-test/artifacts/
projects/therac-25-test/artifacts/*
!projects/therac-25-test/artifacts/ai_segments_takes.json
!projects/therac-25-test/artifacts/entity_census.json
!projects/therac-25-test/artifacts/asset_bible_v6.json
!projects/therac-25-test/artifacts/cost_ledger.jsonl
!projects/therac-25-test/artifacts/duration_map_v6.json
!projects/therac-25-test/research/
projects/therac-25-test/research/*
!projects/therac-25-test/research/*.json
# taum-sauk-2005: same carve-outs (drivers/script arrive at stage -2)
!projects/taum-sauk-2005/
projects/taum-sauk-2005/*
!projects/taum-sauk-2005/research/
projects/taum-sauk-2005/research/*
!projects/taum-sauk-2005/research/*.json
!projects/taum-sauk-2005/research/*.txt
!projects/taum-sauk-2005/research/*.pdf
!projects/taum-sauk-2005/script_v1/
projects/taum-sauk-2005/script_v1/*
!projects/taum-sauk-2005/script_v1/*.yaml
!projects/taum-sauk-2005/script_v1/*.py
!projects/taum-sauk-2005/script_v1/*.md
!projects/taum-sauk-2005/artifacts/
!projects/taum-sauk-2005/feedback/
projects/taum-sauk-2005/feedback/*
!projects/taum-sauk-2005/feedback/events.jsonl
projects/taum-sauk-2005/artifacts/*
!projects/taum-sauk-2005/artifacts/*.json
!projects/taum-sauk-2005/artifacts/*.jsonl

# Corpus directories (downloaded stock clips, thumbnails, embeddings —
# regenerable from source APIs via corpus_builder). Explicit rule even
# though most corpora live under projects/ since agents sometimes
# build scratch corpora at the repo root.
corpus/
**/corpus/

# User music library (personal royalty-free tracks — not part of repo)
music_library/

# Environment & credentials
.env
.env.local
*.env
.youtube-token.json

# Stray media downloads (test/scratch clips left in repo root)
pexels_video_*.mp4

# Scratch/debug scripts
scratch/

# Internal docs (strategy, handoffs, playbooks — not shipped)
internal/

# Local agent config (user-specific)
.claude/memory/
.claude/settings.local.json

# Agent skills lock (local install tracking)
skills-lock.json

# Generated images (logo drafts — final logo lives in assets/)
logo_*.png
generated_image.png

# Downloaded music files (Pixabay, Freesound — not source code)
pixabay_music_*

# OS
.DS_Store
Thumbs.db

# Node (for remotion-composer/)
node_modules/

# Remotion build output and copied project assets (regenerable at render time)
remotion-composer/out/
remotion-composer/public/*
# But keep demo props (shipped with the project for zero-key demos)
!remotion-composer/public/demo-props/
# Ignore test/scratch compositions in demo-props (keep only curated demos)
remotion-composer/public/demo-props/test-*
remotion-composer/public/demo-props/talking-head-*
remotion-composer/public/demo-props/caption-burn-*
